package com.example.caaalc;

import android.os.Bundle;
import android.widget.Button;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    TextView tvExpression;
    TextView tvResult;

    String number1 = "";
    String number2 = "";
    String operator = "";

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        tvExpression = findViewById(R.id.tvExpression);
        tvResult = findViewById(R.id.tvResult);

        // Number buttons
        int[] numbers = {
                R.id.b0, R.id.b1, R.id.b2, R.id.b3,
                R.id.b4, R.id.b5, R.id.b6, R.id.b7,
                R.id.b8, R.id.b9
        };

        for (int id : numbers) {

            Button button = findViewById(id);

            button.setOnClickListener(v -> {

                String value = button.getText().toString();

                if (operator.isEmpty()) {
                    number1 += value;
                } else {
                    number2 += value;
                }

                showExpression();
            });
        }


        // Operators
        findViewById(R.id.bAdd)
                .setOnClickListener(v -> setOperator("+"));

        findViewById(R.id.bSub)
                .setOnClickListener(v -> setOperator("-"));

        findViewById(R.id.bMul)
                .setOnClickListener(v -> setOperator("*"));

        findViewById(R.id.bDiv)
                .setOnClickListener(v -> setOperator("/"));


        // Equal
        findViewById(R.id.bEqual)
                .setOnClickListener(v -> calculate());
    }


    private void setOperator(String op) {

        if (number1.isEmpty()) {
            return;
        }

        operator = op;

        showExpression();
    }


    private void showExpression() {

        String expression =
                number1 + " " +
                operator + " " +
                number2;

        tvExpression.setText(expression);
    }


    private void calculate() {

        if (number1.isEmpty()
                || number2.isEmpty()
                || operator.isEmpty()) {

            return;
        }

        double a = Double.parseDouble(number1);
        double b = Double.parseDouble(number2);

        double result = 0;

        switch (operator) {

            case "+":
                result = a + b;
                break;

            case "-":
                result = a - b;
                break;

            case "*":
                result = a * b;
                break;

            case "/":

                if (b == 0) {
                    tvResult.setText("Result: Error");
                    return;
                }

                result = a / b;
                break;
        }

        tvResult.setText("Result: " + result);
    }
}
